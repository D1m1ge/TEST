{
	"manifest_version": 3,
	"name": "PXModPack v3.0",
	"version": "3.0.0",
	"description": "Mope.io PXModpack v3",
	"icons": {
		"16": "icon_16.png",
		"48": "icon_48.png",
		"128": "icon_128.png"
	},
	"action": {
		"default_icon": "icon_48.png",
		"default_title": "Mope.io Mods"
	},
	"web_accessible_resources": [
		{
			"resources": ["mope.js"],
			"matches": ["<all_urls>"]
		}
	],
	"permissions": [
		"declarativeNetRequest",
		"declarativeNetRequestWithHostAccess"
	],
	"host_permissions": [
		"https://mope.io/*"
	],
	"declarative_net_request": {
		"rule_resources": [
			{
				"id": "ruleset_1",
				"enabled": true,
				"path": "rules.json"
			}
		]
	}
}